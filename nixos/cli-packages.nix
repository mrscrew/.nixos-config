{ pkgs, ... }: {
  # Модуль CLI-утилит для командной строки
  # Продуктивные инструменты: терминал, поиск, навигация, мониторинг, разработка
  
  environment.systemPackages = with pkgs; [
    # Терминал и редактирование
    kitty                # графический терминал для сессии Wayland
    micro                # современный терминальный редактор (мышь, вкладки, плагины, буфер обмена)
    tmux                 # мультиплексор терминала

    # Поиск и навигация
    ripgrep              # быстрый поиск по коду
    fd                   # современная замена find
    fzf                  # нечёткий поиск
    bat                  # просмотр файлов с подсветкой синтаксиса
    eza                  # современная замена ls
    zoxide               # умная навигация по каталогам

    # Мониторинг
    btop                 # монитор ресурсов
    htop                 # процессы

    # Разработка и работа с данными
    git                  # система контроля версий
    lazygit              # TUI для git
    docker               # клиент Docker
    jq                   # работа с JSON

    # Медиа и системные утилиты
    imv                  # просмотрщик изображений
    mpv                  # видеоплеер
    feh                  # лёгкий просмотр изображений / обои
    curl                 # загрузка по сети
    wget                 # загрузка файлов
    unzip                # распаковка ZIP
    tree                 # вывод структуры каталогов
    file                 # определение типа файлов
    usbutils             # утилиты USB
    dconf-editor         # редактор настроек
  ];
}
